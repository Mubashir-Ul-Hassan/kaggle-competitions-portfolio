table for a single country (e.g., **United States**) and then show how to merge it with any daily time series."]},{"cell_type":"code","execution_count":12,"id":"b3a40dea","metadata":{"execution":{"iopub.execute_input":"2026-08-15T10:58:55.5081Z","iopub.status.busy":"2026-08-15T10:58:55.507133Z","iopub.status.idle":"2026-08-15T10:58:55.517616Z","shell.execute_reply":"2026-08-15T10:58:55.516632Z"},"papermill":{"duration":0.025813,"end_time":"2026-08-15T10:58:55.51902+00:00","exception":false,"start_time":"2026-08-15T10:58:55.493207+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["build_holiday_features() defined ✅\n"]}],"source":["# ==============================================================================\n","# 🛠️ FEATURE ENGINEERING: Holiday Features for Time Series\n","# ==============================================================================\n","\n","def build_holiday_features(df, country_code, start_date, end_date):\n","    \"\"\"\n","    Build a daily feature table with holiday-derived features\n","    for a specific country and date range.\n","    \n","    Returns a DataFrame indexed by date with columns:\n","      - is_holiday: binary flag\n","      - holiday_name: name of the holiday (or NaN)\n","      - holiday_type: type of the holiday\n","      - days_to_next_holiday: distance to next holiday\n","      - days_since_last_holiday: distance from previous holiday\n","      - is_holiday_window_3d: 1 if within ±3 days of a holiday\n","      - is_long_weekend: holiday on Mon or Fri (potential long weekend)\n","      - holiday_density_7d: number of holidays in ±7 day window\n","      - is_december: December flag (universal retail/demand surge)\n","      - is_year_end_week: last week of year\n","      - is_year_start_week: first week of year\n","    \"\"\"\n","    # Filter holidays for this country\n","    country_holidays = df[\n","        (df[\"country_code\"] == country_code) & \n","        (df[\"holiday_type\"].str.contains(\"Public\", na=False))\n","    ].copy()\n","    holiday_dates = country_holidays[\"date\"].dt.normalize().unique()\n","    \n","    # Create daily calendar\n","    calendar = pd.DataFrame({\"date\": pd.date_range(start_date, end_date, freq=\"D\")})\n","    \n","    # --- FEATURE 1: is_holiday ---\n","    calendar[\"is_holiday\"] = calendar[\"date\"].isin(holiday_dates).astype(int)\n","    \n","    # --- FEATURE 2: holiday_name & type ---\n","    name_map = country_holidays.drop_duplicates(\"date\").set_index(\"date\")[\"english_name\"]\n","    type_map = country_holidays.drop_duplicates(\"date\").set_index(\"date\")[\"holiday_type\"]\n","    calendar[\"holiday_name\"] = calendar[\"date\"].map(name_map)\n","    calendar[\"holiday_type\"] = calendar[\"date\"].map(type_map)\n","    \n","    # --- FEATURE 3: days_to_next_holiday ---\n","    sorted_holidays = np.sort(holiday_dates)\n","    next_idx = np.searchsorted(sorted_holidays, calendar[\"date\"].values, side=\"right\")\n","    next_idx = np.clip(next_idx, 0, len(sorted_holidays) - 1)\n","    calendar[\"days_to_next_holiday\"] = (sorted_holidays[next_idx] - calendar[\"date\"].values).astype(\"timedelta64[D]\").astype(int)\n","    calendar[\"days_to_next_holiday\"] = calendar[\"days_to_next_holiday\"].clip(lower=0)\n","    \n","    # --- FEATURE 4: days_since_last_holiday ---\n","    prev_idx = np.searchsorted(sorted_holidays, calendar[\"date\"].values, side=\"left\") - 1\n","    prev_idx = np.clip(prev_idx, 0, len(sorted_holidays) - 1)\n","    calendar[\"days_since_last_holiday\"] = (calendar[\"date\"].values - sorted_holidays[prev_idx]).astype(\"timedelta64[D]\").astype(int)\n","    calendar[\"days_since_last_holiday\"] = calendar[\"days_since_last_holiday\"].clip(lower=0)\n","    \n","    # --- FEATURE 5: is_holiday_window_3d ---\n","    calendar[\"is_holiday_window_3d\"] = (\n","        (calendar[\"days_to_next_holiday\"] <= 3) | (calendar[\"days_since_last_holiday\"] <= 3)\n","    ).astype(int)\n","    \n","    # --- FEATURE 6: is_long_weekend ---\n","    dow = calendar[\"date\"].dt.dayofweek\n","    calendar[\"is_long_weekend\"] = (\n","        (calendar[\"is_holiday\"] == 1) & ((dow == 0) | (dow == 4))  # Monday or Friday\n","    ).astype(int)\n","    \n","    # --- FEATURE 7: holiday_density_7d (rolling window) ---\n","    calendar[\"holiday_density_7d\"] = (\n","        calendar[\"is_holiday\"]\n","        .rolling(window=15, center=True, min_periods=1)\n","        .sum()\n","        .astype(int)\n","    )\n","    \n","    # --- FEATURE 8: calendar features ---\n","    calendar[\"is_december\"] = (calendar[\"date\"].dt.month == 12).astype(int)\n","    calendar[\"is_year_end_week\"] = (calendar[\"date\"].dt.isocalendar().week.astype(int) >= 52).astype(int)\n","    calendar[\"is_year_start_week\"] = (calendar[\"date\"].dt.isocalendar().week.astype(int) <= 1).astype(int)\n","    \n","    return calendar\n","\n","print(\"build_holiday_features() defined ✅\")"]},{"cell_type":"code","execution_count":13,"id":"087ec119","metadata":{"execution":{"iopub.execute_input":"2026-08-15T10:58:55.54494Z","iopub.status.busy":"2026-08-15T10:58:55.544658Z","iopub.status.idle":"2026-08-15T10:58:55.591518Z","shell.execute_reply":"2026-08-15T10:58:55.590725Z"},"papermill":{"duration":0.061433,"end_time":"2026-08-15T10:58:55.59277+00:00","exception":false,"start_time":"2026-08-15T10:58:55.531337+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Feature table shape: (2557, 12)\n","Total US holidays found: 83\n","\n","Sample around July 4th, 2024:\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","   