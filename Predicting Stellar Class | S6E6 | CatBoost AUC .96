\" >z</th>\n      <td id=\"T_c14c3_row7_col0\" class=\"data row7 col0\" >577347.000000</td>\n      <td id=\"T_c14c3_row7_col1\" class=\"data row7 col1\" >19.041136</td>\n      <td id=\"T_c14c3_row7_col2\" class=\"data row7 col2\" >1.584365</td>\n      <td id=\"T_c14c3_row7_col3\" class=\"data row7 col3\" >11.682803</td>\n      <td id=\"T_c14c3_row7_col4\" class=\"data row7 col4\" >17.973192</td>\n      <td id=\"T_c14c3_row7_col5\" class=\"data row7 col5\" >19.188598</td>\n      <td id=\"T_c14c3_row7_col6\" class=\"data row7 col6\" >20.162111</td>\n      <td id=\"T_c14c3_row7_col7\" class=\"data row7 col7\" >26.826867</td>\n    </tr>\n    <tr>\n      <th id=\"T_c14c3_level0_row8\" class=\"row_heading level0 row8\" >redshift</th>\n      <td id=\"T_c14c3_row8_col0\" class=\"data row8 col0\" >577347.000000</td>\n      <td id=\"T_c14c3_row8_col1\" class=\"data row8 col1\" >0.723135</td>\n      <td id=\"T_c14c3_row8_col2\" class=\"data row8 col2\" >0.810070</td>\n      <td id=\"T_c14c3_row8_col3\" class=\"data row8 col3\" >-0.009970</td>\n      <td id=\"T_c14c3_row8_col4\" class=\"data row8 col4\" >0.181052</td>\n      <td id=\"T_c14c3_row8_col5\" class=\"data row8 col5\" >0.497525</td>\n      <td id=\"T_c14c3_row8_col6\" class=\"data row8 col6\" >0.881390</td>\n      <td id=\"T_c14c3_row8_col7\" class=\"data row8 col7\" >7.010780</td>\n    </tr>\n  </tbody>\n</table>\n"},"metadata":{}}],"execution_count":6},{"cell_type":"code","source":"# ──────────────────────────────────────────────────────────────────────────────\n# MISSING VALUES CHECK\n# ──────────────────────────────────────────────────────────────────────────────\ntrain_nulls = train.isnull().sum()\ntest_nulls = test.isnull().sum()\n\nif train_nulls.sum() == 0 and test_nulls.sum() == 0:\n    print(\"✅ No missing values in train or test — clean synthetic data!\")\nelse:\n    print(f\"⚠️ Train missing values:\\n{train_nulls[train_nulls > 0]}\")\n    print(f\"⚠️ Test missing values:\\n{test_nulls[test_nulls > 0]}\")","metadata":{"_uuid":"365decc2-b819-4fdd-a2cd-2b24bfd962ee","_cell_guid":"e1606e41-e337-490e-b813-a211fd463ab9","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:19:36.868124Z","iopub.execute_input":"2026-06-07T20:19:36.868318Z","iopub.status.idle":"2026-06-07T20:19:36.987248Z","shell.execute_reply.started":"2026-06-07T20:19:36.868301Z","shell.execute_reply":"2026-06-07T20:19:36.986642Z"}},"outputs":[{"name":"stdout","text":"✅ No missing values in train or test — clean synthetic data!\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"# ──────────────────────────────────────────────────────────────────────────────\n# DUPLICATES CHECK\n# ──────────────────────────────────────────────────────────────────────────────\nfeature_cols = [c for c in train.columns if c not in ['id', 'class']]\nn_dup_train = train.duplicated(subset=feature_cols, keep=False).sum()\nprint(f\"🔄 Duplicate rows in train (by features): {n_dup_train} ({n_dup_train/len(train)*100:.2f}%)\")","metadata":{"_uuid":"003984f5-8c01-4829-bf7b-573a6c6563fc","_cell_guid":"86b950f4-9a43-4e9b-b30d-b914d3e7ec0d","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:19:36.988259Z","iopub.execute_input":"2026-06-07T20:19:36.988623Z","iopub.status.idle":"2026-06-07T20:19:37.466385Z","shell.execute_reply.started":"2026-06-07T20:19:36.9886Z","shell.execute_reply":"2026-06-07T20:19:37.465626Z"}},"outputs":[{"name":"stdout","text":"🔄 Duplicate rows in train (by features): 0 (0.00%)\n","output_type":"stream"}],"execution_count":8},{"cell_type":"markdown","source":"<a id=\"target-analysis\"></a>\n## 3. 🎯 Target Analysis","metadata":{"_uuid":"f407dd3b-18ac-44e6-8695-fb686a7936f7","_cell_guid":"bd1d25b2-36cd-488c-b83d-f1954de762e6","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# TARGET DISTRIBUTION\n# ══════════════════════════════════════════════════════════════════════════════\ntarget_counts = train['class'].value_counts()\ntarget_pct = train['class'].value_counts(normalize=True) * 100\n\nfig, axes = plt.subplots(1, 3, figsize=(18, 5))\nfig.suptitle('Target Class Distribution', fontsize=18, fontweight='bold', color='#e0e0ff', y=1.02)\n\n# Bar chart\nbars = axes[0].bar(target_counts.index, target_counts.values,\n                   color=[CLASS_COLORS[c] for c in target_counts.index],\n                   edgecolor='white', linewidth=0.5, alpha=0.9)\nfor bar, val, pct in zip(bars, target_counts.values, target_pct.values):\n    axes[0].text(bar.get_x() + bar.get_width()/2, bar.get_height() + len(train)*0.005,\n                 f'{val:,}\\n({pct:.1f}%)', ha='center', va='bottom', fontsize=11,\n                 fontweight='bold', color='#e0e0ff')\naxes[0].set_title('Count per Class', fontsize=13, color=ACCENT)\naxes[0].set_ylabel('Count')\n\n# Pie chart\naxes[1].pie(target_counts.values, labels=target_counts.index, autopct='%1.1f%%',\n            colors=[CLASS_COLORS[c] for c in target_counts.index],\n            startangle=90, textprops={'color': '#e0e0ff', 'fontsize': 12},\n            wedgeprops={'edgecolor': '#0d1117', 'linewidth': 2},\n            pctdistance=0.75)\naxes[1].set_title('Class Proportions', fontsize=13, color=ACCENT)\n\n# Imbalance ratio\nclasses_sorted = target_counts.index.tolist()\nratios = [target_counts[c] / target_counts.min() for c in classes_sorted]\naxes[2].barh(classes_sorted, ratios,\n             color=[CLASS_COLORS[c] for c in classes_sorted],\n             edgecolor='white', linewidth=0.5, alpha=0.9)\nfor idx, (cls, ratio) in enumerate(zip(classes_sorted, ratios)):\n    axes[2].text(ratio + 0.05, idx, f'{ratio:.2f}x', va='center', fontsize=12,\n                 fontweight='bold', color='#e0e0ff')\naxes[2].set_title('Imbalance Ratio (vs minority)', fontsize=13, color=ACCENT)\naxes[2].set_xlabel('Ratio')\n\nplt.tight_layout()\nplt.show()\n\n# Print summary\nprint(f\"\\n📊 Target Summary:\")\nprint(f\"   Majority class : {target_counts.index[0]} ({target_counts.values[0]:,} samples)\")\nprint(f\"   Minority class : {target_counts.index[-1]} ({target_counts.values[-1]:,} samples)\")\nprint(f\"   Imbalance ratio: {target_counts.values[0] / target_counts.values[-1]:.2f}x\")","metadata":{"_uuid":"38fa9802-3327-4c9e-b4d7-2b0f35c90300","_cell_guid":"42b21ee5-8ea4-4969-a64a-797a99176711","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:19:37.46757Z","iopub.execute_input":"2026-06-07T20:19:37.467875Z","iopub.status.idle":"2026-06-07T20:19:37.967159Z","shell.execute_reply.started":"2026-06-07T20:19:37.467853Z","shell.execute_reply":"2026-06-07T20:19:37.966494Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1800x500 with 3 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n📊 Target Summary:\n   Majority class : GALAXY (377,480 samples)\n   Minority class : STAR (82,724 samples)\n   Imbalance ratio: 4.56x\n","output_type":"stream"}],"execution_count":9},{"cell_type":"markdown","source":"<a id=\"univariate-eda\"></a>\n## 4. 📊 Univariate EDA — Feature Distributions\n\nLet's examine how each feature is distributed, and — crucially — how distributions differ across the three stellar classes.","metadata":{"_uuid":"cce15c8c-a563-480f-a6c9-551c9d136366","_cell_guid":"3ac61f4d-3c41-4dd9-b704-c83d77b2f6dd","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# IDENTIFY FEATURE GROUPS\n# ══════════════════════════════════════════════════════════════════════════════\nall_features = [c for c in train.columns if c not in ['id', 'class']]\nnumeric_features = train[all_features].select_dtypes(include=[np.number]).columns.tolist()\n\n# Known SDSS feature groups (check which are present)\nPHOTOMETRIC_BANDS = [c for c in ['u', 'g', 'r', 'i', 'z'] if c in numeric_features]\nCOORDINATE_COLS = [c for c in ['alpha', 'delta'] if c in numeric_features]\nREDSHIFT_COLS = [c for c in ['redshift'] if c in numeric_features]\nID_LIKE_COLS = [c for c in ['obj_ID', 'spec_obj_ID', 'rerun_ID', 'run_ID',\n                             'cam_col', 'field_ID', 'plate', 'MJD', 'fiber_ID']\n                if c in numeric_features]\nOTHER_NUMERIC = [c for c in numeric_features if c not in\n                 PHOTOMETRIC_BANDS + COORDINATE_COLS + REDSHIFT_COLS + ID_LIKE_COLS]\n\nprint(f\"📊 Feature Groups Detected:\")\nprint(f\"   Photometric bands : {PHOTOMETRIC_BANDS}\")\nprint(f\"   Coordinates       : {COORDINATE_COLS}\")\nprint(f\"   Redshift          : {REDSHIFT_COLS}\")\nprint(f\"   ID-like / metadata: {ID_LIKE_COLS}\")\nprint(f\"   Other numeric     : {OTHER_NUMERIC}\")\nprint(f\"   Total numeric     : {len(numeric_features)}\")","metadata":{"_uuid":"b8c3b547-ee7a-4bc7-95fe-c74e58b2ca36","_cell_guid":"70f29aff-b45b-4d91-8624-ee98c804317c","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:19:37.969574Z","iopub.execute_input":"2026-06-07T20:19:37.969853Z","iopub.status.idle":"2026-06-07T20:19:38.023756Z","shell.execute_reply.started":"2026-06-07T20:19:37.969832Z","shell.execute_reply":"2026-06-07T20:19:38.023068Z"}},"outputs":[{"name":"stdout","text":"📊 Feature Groups Detected:\n   Photometric bands : ['u', 'g', 'r', 'i', 'z']\n   Coordinates       : ['alpha', 'delta']\n   Redshift          : ['redshift']\n   ID-like / metadata: []\n   Other numeric     : []\n   Total numeric     : 8\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# DISTRIBUTION PLOTS FOR PHOTOMETRIC BANDS (KDE by class)\n# ══════════════════════════════════════════════════════════════════════════════\nif PHOTOMETRIC_BANDS:\n    n_bands = len(PHOTOMETRIC_BANDS)\n    fig, axes = plt.subplots(1, n_bands, figsize=(4 * n_bands, 5))\n    if n_bands == 1:\n        axes = [axes]\n    fig.suptitle('Photometric Band Distributions by Stellar Class',\n                 fontsize=16, fontweight='bold', color='#e0e0ff', y=1.03)\n\n    for ax, band in zip(axes, PHOTOMETRIC_BANDS):\n        for cls in sorted(train['class'].unique()):\n            subset = train[train['class'] == cls][band].dropna()\n            ax.hist(subset, bins=80, alpha=0.5, label=cls,\n                    color=CLASS_COLORS.get(cls, '#888'), density=True)\n            subset.plot.kde(ax=ax, color=CLASS_COLORS.get(cls, '#888'),\n                           linewidth=2)\n        ax.set_title(f'{band}-band', fontsize=13, color=ACCENT)\n        ax.set_xlabel('Magnitude')\n        ax.legend(fontsize=9)\n\n    plt.tight_layout()\n    plt.show()","metadata":{"_uuid":"c528839c-f88e-4227-a467-cb395aff0ba4","_cell_guid":"f521dd28-6dac-4c4f-9688-3d3ea6d718be","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:19:38.024666Z","iopub.execute_input":"2026-06-07T20:19:38.024936Z","iopub.status.idle":"2026-06-07T20:20:28.545391Z","shell.execute_reply.started":"2026-06-07T20:19:38.024908Z","shell.execute_reply":"2026-06-07T20:20:28.544695Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x500 with 5 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":11},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# VIOLIN PLOTS — Photometric bands by class\n# ══════════════════════════════════════════════════════════════════════════════\nif PHOTOMETRIC_BANDS:\n    fig, axes = plt.subplots(1, len(PHOTOMETRIC_BANDS),\n                             figsize=(4 * len(PHOTOMETRIC_BANDS), 6))\n    if len(PHOTOMETRIC_BANDS) == 1:\n        axes = [axes]\n    fig.suptitle('Photometric Band Violin Plots by Class',\n                 fontsize=16, fontweight='bold', color='#e0e0ff', y=1.03)\n\n    for ax, band in zip(axes, PHOTOMETRIC_BANDS):\n        sns.violinplot(data=train, x='class', y=band, ax=ax,\n                       palette=CLASS_COLORS, inner='quartile', alpha=0.8,\n                       order=sorted(train['class'].unique()))\n        ax.set_title(f'{band}-band', fontsize=13, color=ACCENT)\n        ax.set_xlabel('')\n\n    plt.tight_layout()\n    plt.show()","metadata":{"_uuid":"f9691368-2860-4fdb-ac08-e28373dd057d","_cell_guid":"f17c368c-20e7-4674-8fc5-a797e2f499b6","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:20:28.546407Z","iopub.execute_input":"2026-06-07T20:20:28.547073Z","iopub.status.idle":"2026-06-07T20:20:39.145362Z","shell.execute_reply.started":"2026-06-07T20:20:28.54704Z","shell.execute_reply":"2026-06-07T20:20:39.144505Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x600 with 5 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":12},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# REDSHIFT DISTRIBUTION — The most important feature\n# ══════════════════════════════════════════════════════════════════════════════\nif 'redshift' in train.columns:\n    fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n    fig.suptitle('⭐ Redshift — The Most Discriminative Feature',\n                 fontsize=16, fontweight='bold', color='#e0e0ff', y=1.03)\n\n    # KDE by class\n    for cls in sorted(train['class'].unique()):\n        subset = train[train['class'] == cls]['redshift']\n        axes[0].hist(subset, bins=100, alpha=0.45, label=cls,\n                     color=CLASS_COLORS.get(cls, '#888'), density=True)\n        subset.plot.kde(ax=axes[0], color=CLASS_COLORS.get(cls, '#888'),\n                        linewidth=2.5)\n    axes[0].set_title('Redshift Distribution by Class', fontsize=13, color=ACCENT)\n    axes[0].set_xlabel('Redshift')\n    axes[0].set_ylabel('Density')\n    axes[0].legend(fontsize=11)\n\n    # Box plot\n    sns.boxplot(data=train, x='class', y='redshift', ax=axes[1],\n                palette=CLASS_COLORS, order=sorted(train['class'].unique()),\n                flierprops={'marker': 'o', 'markersize': 2, 'alpha': 0.3})\n    axes[1].set_title('Redshift Box Plot by Class', fontsize=13, color=ACCENT)\n\n    plt.tight_layout()\n    plt.show()\n\n    # Print stats\n    print(\"\\n📊 Redshift Statistics by Class:\")\n    print(train.groupby('class')['redshift'].describe().round(4).to_string())","metadata":{"_uuid":"fcc94f52-ea1c-4c0a-b649-f0698fdf30c9","_cell_guid":"7a9112d5-74d6-4b96-bdd1-c03f2c462eb3","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:20:39.146224Z","iopub.execute_input":"2026-06-07T20:20:39.146546Z","iopub.status.idle":"2026-06-07T20:20:50.209105Z","shell.execute_reply.started":"2026-06-07T20:20:39.146524Z","shell.execute_reply":"2026-06-07T20:20:50.208372Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x600 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n📊 Redshift Statistics by Class:\n           count    mean     std     min     25%     50%     75%     max\nclass                                                                   \nGALAXY  377480.0  0.5090  0.3091 -0.0099  0.2670  0.4820  0.7150  6.8603\nQSO     117143.0  1.8756  1.0697  0.0001  1.1318  1.7989  2.5064  7.0108\nSTAR     82724.0  0.0681  0.0645 -0.0100  0.0219  0.0565  0.1021  5.4452\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# ALL NUMERIC FEATURES — KDE grid\n# ══════════════════════════════════════════════════════════════════════════════\nplot_features = [f for f in numeric_features if f not in ['obj_ID', 'spec_obj_ID']]\nn_plot = len(plot_features)\n\nif n_plot > 0:\n    n_cols = 4\n    n_rows = (n_plot + n_cols - 1) // n_cols\n    fig, axes = plt.subplots(n_rows, n_cols, figsize=(5 * n_cols, 4 * n_rows))\n    axes = axes.flatten() if n_plot > 1 else [axes]\n    fig.suptitle('Feature Distributions by Stellar Class',\n                 fontsize=18, fontweight='bold', color='#e0e0ff', y=1.01)\n\n    for idx, feat in enumerate(plot_features):\n        ax = axes[idx]\n        for cls in sorted(train['class'].unique()):\n            subset = train[train['class'] == cls][feat].dropna()\n            if len(subset) > 0:\n                ax.hist(subset, bins=60, alpha=0.4, density=True,\n                        color=CLASS_COLORS.get(cls, '#888'), label=cls)\n        ax.set_title(feat, fontsize=12, color=ACCENT)\n        ax.legend(fontsize=8, loc='upper right')\n\n    for idx in range(n_plot, len(axes)):\n        axes[idx].set_visible(False)\n\n    plt.tight_layout()\n    plt.show()","metadata":{"_uuid":"a1aa5650-8d5f-4380-8030-32b57c1f4db3","_cell_guid":"945c33d6-f68b-4265-800a-af9a9f695d1f","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:20:50.210028Z","iopub.execute_input":"2026-06-07T20:20:50.210332Z","iopub.status.idle":"2026-06-07T20:20:54.241468Z","shell.execute_reply.started":"2026-06-07T20:20:50.21031Z","shell.execute_reply":"2026-06-07T20:20:54.240626Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x800 with 8 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# OUTLIER DETECTION — Box plots\n# ══════════════════════════════════════════════════════════════════════════════\nif len(plot_features) > 0:\n    n_cols = 4\n    n_rows = (len(plot_features) + n_cols - 1) // n_cols\n    fig, axes = plt.subplots(n_rows, n_cols, figsize=(5 * n_cols, 3.5 * n_rows))\n    axes = axes.flatten()\n    fig.suptitle('Outlier Detection — Box Plots',\n                 fontsize=16, fontweight='bold', color='#e0e0ff', y=1.01)\n\n    for idx, feat in enumerate(plot_features):\n        sns.boxplot(data=train, y=feat, x='class', ax=axes[idx],\n                    palette=CLASS_COLORS, order=sorted(train['class'].unique()),\n                    flierprops={'marker': '.', 'markersize': 1, 'alpha': 0.2})\n        axes[idx].set_title(feat, fontsize=11, color=ACCENT)\n        axes[idx].set_xlabel('')\n\n    for idx in range(len(plot_features), len(axes)):\n        axes[idx].set_visible(False)\n\n    plt.tight_layout()\n    plt.show()","metadata":{"_uuid":"d10f5ae3-cd84-434b-bb81-a96b879fec98","_cell_guid":"f0f540d5-1776-4344-a556-7b64dce0ca8f","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:20:54.242673Z","iopub.execute_input":"2026-06-07T20:20:54.243019Z","iopub.status.idle":"2026-06-07T20:21:02.151446Z","shell.execute_reply.started":"2026-06-07T20:20:54.242995Z","shell.execute_reply":"2026-06-07T20:21:02.150635Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x700 with 8 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":15},{"cell_type":"markdown","source":"<a id=\"bivariate-eda\"></a>\n## 5. 🔗 Bivariate & Multivariate EDA","metadata":{"_uuid":"79a3bc76-b693-4afc-bff5-5e651562b1e8","_cell_guid":"d5e3807d-ddac-4e91-8865-ed6abbaba25f","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# CORRELATION HEATMAP\n# ══════════════════════════════════════════════════════════════════════════════\ncorr_features = [f for f in numeric_features if f not in ['obj_ID', 'spec_obj_ID']]\ncorr_matrix = train[corr_features].corr()\n\nfig, ax = plt.subplots(figsize=(14, 11))\nmask = np.triu(np.ones_like(corr_matrix, dtype=bool))\nsns.heatmap(corr_matrix, mask=mask, annot=True, fmt='.2f', cmap=space_cmap,\n            center=0, linewidths=0.5, linecolor='#21262d',\n            annot_kws={'size': 8}, ax=ax,\n            cbar_kws={'label': 'Correlation', 'shrink': 0.8})\nax.set_title('Feature Correlation Heatmap', fontsize=16, fontweight='bold',\n             color='#e0e0ff', pad=20)\nplt.tight_layout()\nplt.show()\n\n# Print highly correlated pairs\nprint(\"\\n🔗 Highly Correlated Feature Pairs (|r| > 0.85):\")\nfor i in range(len(corr_matrix.columns)):\n    for j in range(i+1, len(corr_matrix.columns)):\n        if abs(corr_matrix.iloc[i, j]) > 0.85:\n            print(f\"   {corr_matrix.columns[i]:15s} ↔ {corr_matrix.columns[j]:15s} : {corr_matrix.iloc[i, j]:.3f}\")","metadata":{"_uuid":"191cb226-8a59-4433-b405-e0e2a588cfd8","_cell_guid":"29bc422d-b110-4177-8f86-c2b98d80b5d5","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:21:02.152501Z","iopub.execute_input":"2026-06-07T20:21:02.15305Z","iopub.status.idle":"2026-06-07T20:21:02.548374Z","shell.execute_reply.started":"2026-06-07T20:21:02.153027Z","shell.execute_reply":"2026-06-07T20:21:02.54752Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x1100 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n🔗 Highly Correlated Feature Pairs (|r| > 0.85):\n   g               ↔ r               : 0.912\n   r               ↔ i               : 0.954\n   r               ↔ z               : 0.913\n   i               ↔ z               : 0.969\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# SCATTER PLOTS — Redshift vs Photometric bands (key relationships)\n# ══════════════════════════════════════════════════════════════════════════════\nif 'redshift' in train.columns and len(PHOTOMETRIC_BANDS) > 0:\n    n_bands = min(len(PHOTOMETRIC_BANDS), 5)\n    fig, axes = plt.subplots(1, n_bands, figsize=(5 * n_bands, 5))\n    if n_bands == 1:\n        axes = [axes]\n    fig.suptitle('Redshift vs Photometric Magnitudes',\n                 fontsize=16, fontweight='bold', color='#e0e0ff', y=1.03)\n\n    sample = train.sample(min(10000, len(train)), random_state=CFG.SEED)\n    for ax, band in zip(axes, PHOTOMETRIC_BANDS[:n_bands]):\n        for cls in sorted(train['class'].unique()):\n            mask = sample['class'] == cls\n            ax.scatter(sample.loc[mask, 'redshift'], sample.loc[mask, band],\n                       alpha=0.2, s=5, label=cls,\n                       color=CLASS_COLORS.get(cls, '#888'))\n        ax.set_xlabel('Redshift')\n        ax.set_ylabel(f'{band} magnitude')\n        ax.set_title(f'Redshift vs {band}', fontsize=12, color=ACCENT)\n        ax.legend(fontsize=9, markerscale=3)\n\n    plt.tight_layout()\n    plt.show()","metadata":{"_uuid":"dcfb8140-d56a-4439-a363-ab4a33a405a5","_cell_guid":"4b5099b9-5046-438e-9a72-a9ee8680a7a8","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-06-07T20:21:02.54945Z","iopub.execute_input":"2026-06-07T20:21:02.549748Z","iopub.status.idle":"2026-06-07T20:21:03.805802Z","shell.execute_reply.started":"2026-06-07T20:21:02.549714Z","shell.execute_reply":"2026-06-07T20:21:03.804915Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2500x500 with 5 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":17},{"cell_type":"code","source":"# ══════════════════════════════════════════════════════════════════════════════\n# INTERACTIVE 3D SCATTER — Plotly (u vs g vs r colored by class)\n# ══════════════════════════════════════════════════════════════════════════════\nif len(PHOTOMETRIC_BANDS) >= 3:\n    sample_3d = train.sample(min(5000, len(train)), random_state=CFG.SEED)\n    b1, b2, b3 = PHOTOMETRIC_BANDS[0], PHOTOMETRIC_BANDS[1], PHOTOMETRIC_BANDS[2]\n\n    fig_3d = px.scatter_3d(\n        sample_3d, x=b1, y=b2, z=b3, color='class',\n        color_discrete_map=CLASS_COLORS,\n        opacity=0.5, size_max=3,\n        title=f'3D Scatter: {b1} vs {b2} vs {b3} (colored by class)',\n        template='plotly_dark',\n        height=600\n    )\n    fig_3d.update_traces(marker=dict(size=2))\n    fig_3d.update_layout(\n        scene=dict(\n            xaxis_title=f'{b1} magnitude',\n            yaxis_title=f'{b2} magnitude',\n            zaxis_title=f'{b3} magnitude',\n        ),\n        font=dict(color='#c9d1d9')\n    )\n    fig_3d.show()","metadata":{"_uuid":"ef7ff3d5-e4cf-45f3-a49e-4e19a5b86427","_cell_guid":"9195f4f7-ecb3-4233-bc03-b5e38a5cc80f","trusted":true,"execution":{"iopub.status.busy":"2026-06-07T20:21:03.806897Z","iopub.execute_input":"2026-06-07T20:21:03.80716Z","iopub.status.idle":"2026-06-07T20:21:07.701716Z","shell.execute_reply.started":"2026-06-07T20:21:03.807141Z","shell.execute_reply":"2026-06-07T20:21:07.70114Z"}},"outputs":[{"output_type":"display_data","data":{"text/html":"<html>\n<head><meta charset=\"utf-8\" /></head>\n<body>\n    <div>            <script src=\"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.5/MathJax.js?config=TeX-AMS-MML_SVG\"></script><script type=\"text/javascript\">if (window.MathJax && window.MathJax.Hub && window.MathJax.Hub.Config) {window.MathJax.Hub.Config({SVG: {font: \"STIX-Web\"}});}</script>                <script type=\"text/javascript\">window.PlotlyConfig = {MathJaxConfig: 'local'};</script>\n        <script charset=\"utf-8\" src=\"https://cdn.plot.ly/plotly-2.35.2.min.js\"></script>                <div id=\"19d36932-21ea-433b-a6e0-020206e5af39\" class=\"plotly-graph-div\" style=\"height:600px; width:100%;\"></div>            <script type=\"text/javascript\">                                    window.PLOTLYENV=window.PLOTLYENV || {};                                    if (document.getE