ckground-color: #e31a1c;\n  color: #f1f1f1;\n}\n</style>\n<table id=\"T_c14c3\">\n  <thead>\n    <tr>\n      <th class=\"blank level0\" >&nbsp;</th>\n      <th id=\"T_c14c3_level0_col0\" class=\"col_heading level0 col0\" >count</th>\n      <th id=\"T_c14c3_level0_col1\" class=\"col_heading level0 col1\" >mean</th>\n      <th id=\"T_c14c3_level0_col2\" class=\"col_heading level0 col2\" >std</th>\n      <th id=\"T_c14c3_level0_col3\" class=\"col_heading level0 col3\" >min</th>\n      <th id=\"T_c14c3_level0_col4\" class=\"col_heading level0 col4\" >25%</th>\n      <th id=\"T_c14c3_level0_col5\" class=\"col_heading level0 col5\" >50%</th>\n      <th id=\"T_c14c3_level0_col6\" class=\"col_heading level0 col6\" >75%</th>\n      <th id=\"T_c14c3_level0_col7\" class=\"col_heading level0 col7\" >max</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th id=\"T_c14c3_level0_row0\" class=\"row_heading level0 row0\" >id</th>\n      <td id=\"T_c14c3_row0_col0\" class=\"data row0 col0\" >577347.000000</td>\n      <td id=\"T_c14c3_row0_col1\" class=\"data row0 col1\" >288673.000000</td>\n      <td id=\"T_c14c3_row0_col2\" class=\"data row0 col2\" >166665.867270</td>\n      <td id=\"T_c14c3_row0_col3\" class=\"data row0 col3\" >0.000000</td>\n      <td id=\"T_c14c3_row0_col4\" class=\"data row0 col4\" >144336.500000</td>\n      <td id=\"T_c14c3_row0_col5\" class=\"data row0 col5\" >288673.000000</td>\n      <td id=\"T_c14c3_row0_col6\" class=\"data row0 col6\" >433009.500000</td>\n      <td id=\"T_c14c3_row0_col7\" class=\"data row0 col7\" >577346.000000</td>\n    </tr>\n    <tr>\n      <th id=\"T_c14c3_level0_row1\" class=\"row_heading level0 row1\" >alpha</th>\n      <td id=\"T_c14c3_row1_col0\" class=\"data row1 col0\" >577347.000000</td>\n      <td id=\"T_c14c3_row1_col1\" class=\"data row1 col1\" >181.616673</td>\n      <td id=\"T_c14c3_row1_col2\" class=\"data row1 col2\" >96.242941</td>\n      <td id=\"T_c14c3_row1_col3\" class=\"data row1 col3\" >0.011684</td>\n      