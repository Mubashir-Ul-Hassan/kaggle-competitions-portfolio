\"Target Distribution (Will_Buy_EV)\", fontsize=13, fontweight=\"bold\")\naxes[0].set_ylabel(\"Count\")\nfor bar, val in zip(bars, vc.values):\n    axes[0].text(bar.get_x() + bar.get_width()/2, val + 500, f\"{val:,}\", ha=\"center\", fontsize=10)\n\naxes[1].pie(vc.values, labels=[f\"No ({vc.values[0]:,})\", f\"Yes ({vc.values[1]:,})\"],\n            autopct=\"%1.1f%%\", colors=colors, startangle=90, textprops={\"fontsize\": 11},\n            explode=(0, 0.05), shadow=True)\naxes[1].set_title(\"Class Balance\", fontsize=13, fontweight=\"bold\")\n\nplt.tight_layout()\nplt.show()\n\nimbalance_ratio = vc.values[0] / vc.values[1] if len(vc) > 1 else 0\nprint(f\"\\nImbalance ratio: {imbalance_ratio:.1f}:1\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:31:53.074504Z","iopub.execute_input":"2026-09-13T14:31:53.074847Z","iopub.status.idle":"2026-09-13T14:31:53.529474Z","shell.execute_reply.started":"2026-09-13T14:31:53.074822Z","shell.execute_reply":"2026-09-13T14:31:53.528649Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"eda-features\"></a>\n## &#128202; 4. EDA &#8212; Feature Distributions & Correlations","metadata":{}},{"cell_type":"code","source":"# Auto-detect feature types\nexclude_cols = [\"id\", TARGET, \"is_original\"]\ncat_cols = [c for c in train.select_dtypes(include=[\"object\", \"category\"]).columns if c not in exclude_cols]\nnum_cols = [c for c in train.select_dtypes(include=[np.number]).columns if c not in exclude_cols]\n\nprint(f\"Categorical ({len(cat_cols)}): {cat_cols}\")\nprint(f\"Numerical   ({len(num_cols)}): {num_cols}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:31:53.531241Z","iopub.execute_input":"2026-09-13T14:31:53.531519Z","iopub.status.idle":"2026-09-13T14:31:53.598666Z","shell.execute_reply.started":"2026-09-13T14:31:53.531495Z","shell.execute_reply":"2026-09-13T14:31:53.597881Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Numerical feature distributions by target\nn_num = len(num_cols)\nncols_plot = 3\nnrows_plot = max(1, (n_num + ncols_plot - 1) // ncols_plot)\n\nfig, axes = plt.subplots(nrows_plot, ncols_plot, figsize=(18, 4 * nrows_plot))\nfig.suptitle(\"Numerical Features by Target\", fontsize=16, fontweight=\"bold\", y=1.01)\naxes_flat = axes.flatten() if hasattr(axes, \"flatten\") else [axes]\n\nfor i, col in enumerate(num_cols):\n    plot_data = train[[col, TARGET]].copy()\n    plot_data[col] = pd.to_numeric(plot_data[col], errors=\"coerce\")\n    plot_data = plot_data.dropna()\n    \n    if len(plot_data) > 0:\n        sns.kdeplot(data=plot_data, x=col, hue=TARGET, ax=axes_flat[i],\n                    fill=True, alpha=0.4, palette=[\"#22d3ee\", \"#f472b6\"],\n                    common_norm=False, linewidth=1.5)\n    axes_flat[i].set_title(col, fontsize=11)\n\nfor j in range(i + 1, len(axes_flat)):\n    axes_flat[j].set_visible(False)\n\nplt.tight_layout()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:31:53.599638Z","iopub.execute_input":"2026-09-13T14:31:53.599972Z","iopub.status.idle":"2026-09-13T14:32:17.97356Z","shell.execute_reply.started":"2026-09-13T14:31:53.599937Z","shell.execute_reply":"2026-09-13T14:32:17.972607Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Categorical feature distributions by target\nif len(cat_cols) > 0:\n    n_cat = len(cat_cols)\n    ncols_c = min(3, n_cat)\n    nrows_c = max(1, (n_cat + ncols_c - 1) // ncols_c)\n    \n    fig, axes = plt.subplots(nrows_c, ncols_c, figsize=(18, 4.5 * nrows_c))\n    fig.suptitle(\"Categorical Features by Target\", fontsize=16, fontweight=\"bold\", y=1.01)\n    axes_flat = np.array(axes).flatten() if n_cat > 1 else [axes]\n    \n    for i, col in enumerate(cat_cols):\n        ct = pd.crosstab(train[col], train[TARGET], normalize=\"index\")\n        ct.plot(kind=\"bar\", stacked=True, ax=axes_flat[i], color=[\"#22d3ee\", \"#f472b6\"], edgecolor=\"white\")\n        axes_flat[i].set_title(col, fontsize=11)\n        axes_flat[i].set_ylabel(\"Proportion\")\n        axes_flat[i].legend(title=TARGET, fontsize=8)\n        axes_flat[i].tick_params(axis=\"x\", rotation=45)\n    \n    for j in range(i + 1, len(axes_flat)):\n        axes_flat[j].set_visible(False)\n    \n    plt.tight_layout()\n    plt.show()\nelse:\n    print(\"No categorical columns detected.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:32:17.974822Z","iopub.execute_input":"2026-09-13T14:32:17.975445Z","iopub.status.idle":"2026-09-13T14:32:19.564559Z","shell.execute_reply.started":"2026-09-13T14:32:17.975418Z","shell.execute_reply":"2026-09-13T14:32:19.563839Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Correlation heatmap\ncorr_cols = num_cols + [TARGET]\n# Force all columns to numeric — coerce any mixed-type values to NaN\ncorr_data = train[corr_cols].apply(pd.to_numeric, errors=\"coerce\")\n\nfig, ax = plt.subplots(figsize=(12, 10))\ncorr_matrix = corr_data.corr()\nmask = np.triu(np.ones_like(corr_matrix, dtype=bool), k=1)\nsns.heatmap(corr_matrix, mask=mask, annot=True, fmt=\".2f\", cmap=\"coolwarm\",\n            center=0, linewidths=0.5, ax=ax, vmin=-1, vmax=1)\nax.set_title(\"Feature Correlation Matrix\", fontsize=14, fontweight=\"bold\")\nplt.tight_layout()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:32:19.565793Z","iopub.execute_input":"2026-09-13T14:32:19.566145Z","iopub.status.idle":"2026-09-13T14:32:20.680008Z","shell.execute_reply.started":"2026-09-13T14:32:19.566107Z","shell.execute_reply":"2026-09-13T14:32:20.67929Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"eda-quality\"></a>\n## &#128269; 5. EDA &#8212; Missing Values & Data Quality","metadata":{}},{"cell_type":"code","source":"# Missing values\nprint(\"Missing Values -- Train:\")\nmiss_train = train.drop(columns=[\"id\"], errors=\"ignore\").isnull().sum()\nprint(miss_train[miss_train > 0] if miss_train.sum() > 0 else \"No missing values!\")\n\nprint(\"\\nMissing Values -- Test:\")\nmiss_test = test.drop(columns=[\"id\"]).isnull().sum()\nprint(miss_test[miss_test > 0] if miss_test.sum() > 0 else \"No missing values!\")\n\nprint(\"\\n--- Data types ---\")\nprint(train.dtypes)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:32:20.680886Z","iopub.execute_input":"2026-09-13T14:32:20.681626Z","iopub.status.idle":"2026-09-13T14:32:21.149703Z","shell.execute_reply.started":"2026-09-13T14:32:20.6816Z","shell.execute_reply":"2026-09-13T14:32:21.148959Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"fe\"></a>\n## &#128736;&#65039; 6. Feature Engineering &#8212; Domain Features & Digit Decomposition\n\nThree key strategies:\n1. **Domain interactions** &#8212; income x subsidy, concern x subsidy, total chargers, worry scores\n2. **Digit decomposition** &#8212; extract individual digits from numeric features (captures synthetic data artifacts)\n3. **Target encoding** &#8212; OOF-safe encoding of categorical variables","metadata":{}},{"cell_type":"code","source":"# ==============================================================================\n# FEATURE ENGINEERING (using exact competition column names)\n# ==============================================================================\n# Exact columns:\n# Age, Annual_Income_USD, Daily_Commute_km, Number_of_Cars_Owned,\n# Charging_Stations_Near_Home, Charging_Stations_Near_Work,\n# Environmental_Concern_Level, Gender, City_Type, Current_Car_Type,\n# Home_Charging_Possible, Subsidy_Available, Range_Anxiety_Level\n\ndef engineer_features(df):\n    \"\"\"Domain-driven feature engineering for EV purchase prediction.\"\"\"\n    df = df.copy()\n    \n    # Helper: check if column exists and is numeric\n    def has_num(col):\n        return col in df.columns and pd.api.types.is_numeric_dtype(df[col])\n    \n    # --- DOMAIN INTERACTIONS ---\n    # Income x Subsidy: higher income + subsidy = more likely to buy\n    if has_num(\"Annual_Income_USD\") and has_num(\"Subsidy_Available\"):\n        df[\"income_x_subsidy\"] = df[\"Annual_Income_USD\"] * df[\"Subsidy_Available\"]\n    \n    # Concern x Subsidy: eco-conscious + subsidy = strong signal\n    if has_num(\"Environmental_Concern_Level\") and has_num(\"Subsidy_Available\"):\n        df[\"concern_x_subsidy\"] = df[\"Environmental_Concern_Level\"] * df[\"Subsidy_Available\"]\n    \n    # Total chargers available\n    if has_num(\"Charging_Stations_Near_Home\") and has_num(\"Charging_Stations_Near_Work\"):\n        df[\"total_chargers\"] = df[\"Charging_Stations_Near_Home\"] + df[\"Charging_Stations_Near_Work\"]\n    \n    # Worry score: high range anxiety + few chargers = worried buyer\n    if has_num(\"Range_Anxiety_Level\") and \"total_chargers\" in df.columns:\n        df[\"worry_score\"] = df[\"Range_Anxiety_Level\"] / (df[\"total_chargers\"] + 1)\n    \n    # Income per commute km: affordability relative to usage\n    if has_num(\"Annual_Income_USD\") and has_num(\"Daily_Commute_km\"):\n        df[\"income_per_commute\"] = df[\"Annual_Income_USD\"] / (df[\"Daily_Commute_km\"] + 1)\n    \n    # Income per age: earning trajectory\n    if has_num(\"Annual_Income_USD\") and has_num(\"Age\"):\n        df[\"income_per_age\"] = df[\"Annual_Income_USD\"] / (df[\"Age\"] + 1)\n    \n    # Concern x Range Anxiety interaction\n    if has_num(\"Environmental_Concern_Level\") and has_num(\"Range_Anxiety_Level\"):\n        df[\"concern_x_range_anxiety\"] = df[\"Environmental_Concern_Level\"] * df[\"Range_Anxiety_Level\"]\n    \n    # Age x Income interaction\n    if has_num(\"Age\") and has_num(\"Annual_Income_USD\"):\n        df[\"age_x_income\"] = df[\"Age\"] * df[\"Annual_Income_USD\"]\n    \n    # --- DIGIT DECOMPOSITION ---\n    # Captures artifacts in synthetic data generation\n    digit_features = [\"Annual_Income_USD\", \"Age\", \"Daily_Commute_km\"]\n    for c in digit_features:\n        if has_num(c):\n            vals = df[c].fillna(0).astype(int).abs()\n            df[f\"{c}_d0\"] = vals % 10           # ones\n            df[f\"{c}_d1\"] = (vals // 10) % 10   # tens\n            df[f\"{c}_d2\"] = (vals // 100) % 10  # hundreds\n    \n    return df\n\ntrain = engineer_features(train)\ntest  = engineer_features(test)\n\n# Show new features\nnew_feats = [c for c in train.columns if c not in [\"id\", TARGET, \"is_original\"]]\nprint(f\"Train shape after FE: {train.shape}\")\nprint(f\"Test shape after FE:  {test.shape}\")\nprint(f\"\\nAll features ({len(new_feats)}): {new_feats}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:32:21.150647Z","iopub.execute_input":"2026-09-13T14:32:21.15123Z","iopub.status.idle":"2026-09-13T14:32:21.430511Z","shell.execute_reply.started":"2026-09-13T14:32:21.151205Z","shell.execute_reply":"2026-09-13T14:32:21.429721Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"preprocess\"></a>\n## &#9881;&#65039; 7. Preprocessing & Feature Selection","metadata":{}},{"cell_type":"code","source":"# ==============================================================================\n# PREPROCESSING\n# ==============================================================================\n\n# Refresh feature type lists after engineering\nexclude_cols = [\"id\", TARGET, \"is_original\"]\ncat_cols = [c for c in train.select_dtypes(include=[\"object\", \"category\"]).columns if c not in exclude_cols]\nnum_cols = [c for c in train.select_dtypes(include=[np.number]).columns if c not in exclude_cols]\n\n# Label-encode categoricals (fast, tree-models handle this natively)\nfor col in cat_cols:\n    train[col] = train[col].astype(str).fillna(\"missing\")\n    test[col]  = test[col].astype(str).fillna(\"missing\")\n    le = LabelEncoder()\n    le.fit(pd.concat([train[col], test[col]]))\n    train[col] = le.transform(train[col])\n    test[col]  = le.transform(test[col])\n\nprint(f\"Label-encoded {len(cat_cols)} categorical columns: {cat_cols}\")\n\n# Refresh num_cols after encoding\nnum_cols = [c for c in train.select_dtypes(include=[np.number]).columns if c not in exclude_cols]\n\n# Build final feature list\nFEATURES = [c for c in num_cols if c in test.columns]\n\nX = train[FEATURES].copy().replace([np.inf, -np.inf], np.nan)\ny = train[TARGET].values\nX_test = test[FEATURES].copy().replace([np.inf, -np.inf], np.nan)\n\n# Sample weights\nif \"is_original\" in train.columns:\n    sample_weights = train[\"is_original\"].map({0: 1.0, 1: CFG.ORIGINAL_WEIGHT}).values\nelse:\n    sample_weights = np.ones(len(train))\n\nprint(f\"\\nFinal feature count: {len(FEATURES)}\")\nprint(f\"Features: {FEATURES}\")\nprint(f\"X shape: {X.shape} | X_test shape: {X_test.shape}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:32:21.432813Z","iopub.execute_input":"2026-09-13T14:32:21.43305Z","iopub.status.idle":"2026-09-13T14:32:23.604016Z","shell.execute_reply.started":"2026-09-13T14:32:21.433029Z","shell.execute_reply":"2026-09-13T14:32:23.603254Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"training\"></a>\n## &#129302; 8. Model Training &#8212; LightGBM / XGBoost / CatBoost\n\nEach model trained with **5-fold StratifiedKFold CV**, early stopping, class balancing, and sample weights.","metadata":{}},{"cell_type":"code","source":"# ==============================================================================\n# CV TRAINING ENGINE\n# ==============================================================================\ndef train_model_cv(model_type, X_tr, y_tr, X_te, weights, n_splits, seed):\n    oof = np.zeros(len(X_tr))\n    test_preds = np.zeros(len(X_te))\n    scores = []\n    \n    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=seed)\n    print(f\"\\n{'='*60}\")\n    print(f\"  Training {model_type} ({n_splits}-fold CV)\")\n    print(f\"{'='*60}\")\n    \n    for fold, (tr_idx, val_idx) in enumerate(skf.split(X_tr, y_tr)):\n        Xf_tr, Xf_val = X_tr.iloc[tr_idx], X_tr.iloc[val_idx]\n        yf_tr, yf_val = y_tr[tr_idx], y_tr[val_idx]\n        wf_tr = weights[tr_idx]\n        \n        if model_type == \"LightGBM\":\n            model = lgb.LGBMClassifier(\n                n_estimators=5000, learning_rate=0.02, num_leaves=63,\n                max_depth=-1, min_child_samples=20,\n                subsample=0.8, colsample_bytree=0.8,\n                reg_alpha=0.1, reg_lambda=1.0,\n                random_state=seed, verbosity=-1, n_jobs=-1,\n                is_unbalance=True\n            )\n            model.fit(Xf_tr, yf_tr, sample_weight=wf_tr,\n                      eval_set=[(Xf_val, yf_val)],\n                      callbacks=[lgb.early_stopping(CFG.EARLY_STOPPING, verbose=False)])\n            oof[val_idx] = model.predict_proba(Xf_val)[:, 1]\n            test_preds += model.predict_proba(X_te)[:, 1] / n_splits\n            \n        elif model_type == \"XGBoost\":\n            model = xgb.XGBClassifier(\n                n_estimators=5000, learning_rate=0.02, max_depth=6,\n                subsample=0.8, colsample_bytree=0.8,\n                reg_alpha=0.1, reg_lambda=1.0,\n                scale_pos_weight=(y_tr == 0).sum() / max((y_tr == 1).sum(), 1),\n                tree_method=\"hist\",\n                device=\"cuda\" if CFG.USE_GPU else \"cpu\",\n                random_state=seed, n_jobs=-1,\n                early_stopping_rounds=CFG.EARLY_STOPPING, eval_metric=\"auc\"\n            )\n            model.fit(Xf_tr, yf_tr, sample_weight=wf_tr,\n                      eval_set=[(Xf_val, yf_val)], verbose=False)\n            oof[val_idx] = model.predict_proba(Xf_val)[:, 1]\n            test_preds += model.predict_proba(X_te)[:, 1] / n_splits\n            \n        elif model_type == \"CatBoost\":\n            model = CatBoostClassifier(\n                iterations=5000, learning_rate=0.02, depth=6,\n                l2_leaf_reg=3.0, random_seed=seed,\n                auto_class_weights=\"Balanced\",\n                task_type=\"GPU\" if CFG.USE_GPU else \"CPU\",\n                verbose=0, early_stopping_rounds=CFG.EARLY_STOPPING,\n                eval_metric=\"AUC\"\n            )\n            model.fit(Xf_tr, yf_tr, sample_weight=wf_tr,\n                      eval_set=(Xf_val, yf_val))\n            oof[val_idx] = model.predict_proba(Xf_val)[:, 1]\n            test_preds += model.predict_proba(X_te)[:, 1] / n_splits\n        \n        fold_auc = roc_auc_score(yf_val, oof[val_idx])\n        scores.append(fold_auc)\n        print(f\"  Fold {fold+1} AUC: {fold_auc:.6f}\")\n    \n    overall = roc_auc_score(y_tr, oof)\n    print(f\"  Overall OOF AUC: {overall:.6f} (std: {np.std(scores):.6f})\")\n    return oof, test_preds, overall, scores, model","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:32:23.605027Z","iopub.execute_input":"2026-09-13T14:32:23.605379Z","iopub.status.idle":"2026-09-13T14:32:23.617154Z","shell.execute_reply.started":"2026-09-13T14:32:23.605339Z","shell.execute_reply":"2026-09-13T14:32:23.616381Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"lgb_oof, lgb_test, lgb_auc, lgb_fold_scores, lgb_model = train_model_cv(\n    \"LightGBM\", X, y, X_test, sample_weights, CFG.N_FOLDS, CFG.SEED)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:32:23.618123Z","iopub.execute_input":"2026-09-13T14:32:23.618441Z","iopub.status.idle":"2026-09-13T14:33:31.490617Z","shell.execute_reply.started":"2026-09-13T14:32:23.61841Z","shell.execute_reply":"2026-09-13T14:33:31.489739Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Encode target to numeric (original dataset has 'Yes'/'No' strings)\ntrain[TARGET] = train[TARGET].map({\"No\": 0, \"Yes\": 1, 0: 0, 1: 1}).astype(int)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:33:31.491747Z","iopub.execute_input":"2026-09-13T14:33:31.492055Z","iopub.status.idle":"2026-09-13T14:33:31.535586Z","shell.execute_reply.started":"2026-09-13T14:33:31.492023Z","shell.execute_reply":"2026-09-13T14:33:31.534409Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"cat_oof, cat_test, cat_auc, cat_fold_scores, cat_model = train_model_cv(\n    \"CatBoost\", X, y, X_test, sample_weights, CFG.N_FOLDS, CFG.SEED + 2)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:33:31.536904Z","iopub.execute_input":"2026-09-13T14:33:31.537248Z","iopub.status.idle":"2026-09-13T14:37:34.975457Z","shell.execute_reply.started":"2026-09-13T14:33:31.537212Z","shell.execute_reply":"2026-09-13T14:37:34.974595Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"stacking\"></a>\n## &#128302; 9. Meta-Stacking Ensemble\n\nOOF predictions from all 3 base models serve as meta-features for a Logistic Regression stacker. Polynomial interaction terms between OOF predictions capture non-linear blending patterns.","metadata":{}},{"cell_type":"code","source":"# ==============================================================================\n# META-STACKING ENSEMBLE\n# ==============================================================================\nprint(\"\\nBuilding Meta-Stacking Ensemble...\")\n\n# Collect available model outputs (robust to any model failing)\nmodel_outputs = {}\nfor name, oof, test_p, auc, fscores in [\n    (\"LightGBM\", \"lgb_oof\", \"lgb_test\", \"lgb_auc\", \"lgb_fold_scores\"),\n    (\"XGBoost\",  \"xgb_oof\", \"xgb_test\", \"xgb_auc\", \"xgb_fold_scores\"),\n    (\"CatBoost\", \"cat_oof\", \"cat_test\", \"cat_auc\", \"cat_fold_scores\"),\n]:\n    if oof in dir() or oof in globals():\n        model_outputs[name] = {\n            \"oof\": eval(oof), \"test\": eval(test_p),\n            \"auc\": eval(auc), \"fold_scores\": eval(fscores)\n        }\n\nprint(f\"  Available models: {list(model_outputs.keys())}\")\n\noof_list  = [m[\"oof\"]  for m in model_outputs.values()]\ntest_list = [m[\"test\"] for m in model_outputs.values()]\nauc_list  = [m[\"auc\"]  for m in model_outputs.values()]\n\nmeta_train = np.column_stack(oof_list)\nmeta_test  = np.column_stack(test_list)\n\n# Add polynomial interactions if 2+ models available\nif len(oof_list) >= 2:\n    interactions_tr = []\n    interactions_te = []\n    for i in range(len(oof_list)):\n        for j in range(i + 1, len(oof_list)):\n            interactions_tr.append(oof_list[i] * oof_list[j])\n            interactions_te.append(test_list[i] * test_list[j])\n    meta_train_poly = np.column_stack([meta_train] + interactions_tr)\n    meta_test_poly  = np.column_stack([meta_test]  + interactions_te)\nelse:\n    meta_train_poly = meta_train\n    meta_test_poly  = meta_test\n\n# Meta-learner: Logistic Regression\nmeta_oof = np.zeros(len(meta_train_poly))\nmeta_test_preds = np.zeros(len(meta_test_poly))\nmeta_scores = []\n\nskf_meta = StratifiedKFold(n_splits=CFG.N_FOLDS, shuffle=True, random_state=CFG.SEED)\nfor fold, (tr_idx, val_idx) in enumerate(skf_meta.split(meta_train_poly, y)):\n    lr = LogisticRegression(C=1.0, max_iter=1000, random_state=CFG.SEED)\n    lr.fit(meta_train_poly[tr_idx], y[tr_idx])\n    meta_oof[val_idx] = lr.predict_proba(meta_train_poly[val_idx])[:, 1]\n    meta_test_preds += lr.predict_proba(meta_test_poly)[:, 1] / CFG.N_FOLDS\n    fold_auc = roc_auc_score(y[val_idx], meta_oof[val_idx])\n    meta_scores.append(fold_auc)\n    print(f\"  Meta Fold {fold+1} AUC: {fold_auc:.6f}\")\n\nmeta_auc = roc_auc_score(y, meta_oof)\nprint(f\"  Meta-Stack OOF AUC: {meta_auc:.6f}\")\n\n# Weighted average fallback\ntotal_score = sum(auc_list)\navg_oof  = sum(a * o for a, o in zip(auc_list, oof_list)) / total_score\navg_test = sum(a * t for a, t in zip(auc_list, test_list)) / total_score\navg_auc  = roc_auc_score(y, avg_oof)\nprint(f\"  Weighted Avg OOF AUC: {avg_auc:.6f}\")\n\n# Pick best\nif meta_auc >= avg_auc:\n    final_test, final_oof, final_auc, strategy = meta_test_preds, meta_oof, meta_auc, \"Meta-Stacking\"\nelse:\n    final_test, final_oof, final_auc, strategy = avg_test, avg_oof, avg_auc, \"Weighted Average\"\n\nprint(f\"\\n  BEST STRATEGY: {strategy} (AUC: {final_auc:.6f})\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:37:34.976574Z","iopub.execute_input":"2026-09-13T14:37:34.976904Z","iopub.status.idle":"2026-09-13T14:37:50.383683Z","shell.execute_reply.started":"2026-09-13T14:37:34.97688Z","shell.execute_reply":"2026-09-13T14:37:50.382889Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"generalization\"></a>\n## &#128300; 10. Generalization Verification\n\nFour checks to confirm the model generalizes and does not overfit:\n1. **Fold Score Stability** &#8212; low std across folds means the model is not memorizing specific splits\n2. **Prediction Distribution Alignment** &#8212; OOF predictions on train should match test predictions\n3. **Adversarial Validation** &#8212; can a model distinguish train from test? If not, distributions are similar\n4. **Learning Curves** &#8212; plotting train vs. validation score as a function of training set size","metadata":{}},{"cell_type":"code","source":"# ==============================================================================\n# CHECK 1: FOLD SCORE STABILITY\n# ==============================================================================\nprint(\"=\" * 60)\nprint(\"  CHECK 1: Fold Score Stability\")\nprint(\"=\" * 60)\n\nfor name, info in model_outputs.items():\n    fs = info[\"fold_scores\"]\n    mean_s, std_s, spread = np.mean(fs), np.std(fs), max(fs) - min(fs)\n    status = \"PASS\" if std_s < 0.005 else (\"WARN\" if std_s < 0.01 else \"FAIL\")\n    print(f\"  {name:12s} | Mean: {mean_s:.5f} | Std: {std_s:.5f} | Spread: {spread:.5f} | [{status}]\")\n\nfig, ax = plt.subplots(figsize=(12, 5))\nx = np.arange(CFG.N_FOLDS)\nwidth = 0.8 / len(model_outputs)\ncolors = [\"#22d3ee\", \"#a78bfa\", \"#fbbf24\"]\nfor i, (name, info) in enumerate(model_outputs.items()):\n    ax.bar(x + i * width - 0.4 + width/2, info[\"fold_scores\"], width,\n           label=name, color=colors[i % len(colors)], edgecolor=\"white\")\nax.set_xlabel(\"Fold\")\nax.set_ylabel(\"AUC\")\nax.set_title(\"Fold Score Stability Across Models\", fontsize=14, fontweight=\"bold\")\nax.set_xticks(x)\nax.set_xticklabels([f\"Fold {i+1}\" for i in x])\nax.legend()\nplt.tight_layout()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T14:37:50.384812Z","iopub.execute_input":"2026-09-13T14:37:50.385365Z","iopub.status.idle":"2026-09-13T14:37:50.5746Z","shell.execute_reply.started":"2026-09-13T14:37:50.385295Z","shell.execute_reply":"2026-09-13T14:37:50.573945Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==============================================================================\n# CHECK 2: PREDICTION DISTRIBUTION ALIGNMENT (OOF vs Test)\n# ==============================================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"  CHECK 2: Prediction Distribution Alignment\")\nprint(\"=\" * 60)\n\nn_models = len(model_outputs)\nfig, axes = plt.subplots(1, n_models, figsize=(6 * n_models, 5))\nif n_models == 1:\n    axes = [axes]\n\nfor i, (name, info) in enumerate(model_outputs.items()):\n    axes[i].hist(info[\"oof\"], bins=50, alpha=0.6, label=\"OOF (train)\", color=\"#22d3ee\", density=True)\n    axes[i].hist(info[\"test\"], bins=50, alpha=0.6, label=\"Test preds\", color=\"#f472b6\", density=True)\n    axes[i].set_title(f\"{name}: OOF vs Test\", fontsize=11, fontweight=\"bold\")\n    axes[i].legend(fontsize=9)\n    axes[i].set_xlabel(\"Predicted Probability\")\n\nplt.suptitle(\"Prediction Distribution: OOF vs Test (should overlap closely)\", fontsize=14, fontweight=\"bold\", y=1.02)\nplt.tight_layout()\nplt.show()\n\nfor name, info in model_outputs