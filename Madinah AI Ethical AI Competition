ndom_state=seed)\n        splits = list(cv.split(X_tr, y_tr))\n    \n    print(f'\\n{\"=\"*60}')\n    print(f'Training {model_type} — {label} ({len(splits)}-fold CV)')\n    print(f'{\"=\"*60}')\n    \n    for fold, (tr_idx, val_idx) in enumerate(splits):\n        Xf_tr, Xf_val = X_tr.iloc[tr_idx], X_tr.iloc[val_idx]\n        yf_tr, yf_val = y_tr[tr_idx], y_tr[val_idx]\n        \n        if model_type == 'LightGBM':\n            model = lgb.LGBMRegressor(\n                n_estimators=5000, objective='mae', metric='mae',\n                learning_rate=best_params.get('learning_rate', 0.02),\n                num_leaves=best_params.get('num_leaves', 63),\n                max_depth=best_params.get('max_depth', -1),\n                min_child_samples=best_params.get('min_child_samples', 20),\n                subsample=best_params.get('subsample', 0.8),\n                colsample_bytree=best_params.get('colsample_bytree', 0.8),\n                reg_alpha=best_params.get('reg_alpha', 0.1),\n                reg_lambda=best_params.get('reg_lambda', 1.0),\n                min_split_gain=best_params.get('min_split_gain', 0.0),\n                random_state=seed, verbosity=-1, n_jobs=-1\n            )\n            model.fit(Xf_tr, yf_tr, eval_set=[(Xf_val, yf_val)],\n                      callbacks=[lgb.early_stopping(CFG.EARLY_STOPPING, verbose=False)])\n            oof[val_idx] = model.predict(Xf_val)\n            train_pred = model.predict(Xf_tr)\n            test_preds += model.predict(X_te) / len(splits)\n            n_trees_used.append(model.best_iteration_)\n            \n        elif model_type == 'XGBoost':\n            model = xgb.XGBRegressor(\n                n_estimators=5000, objective='reg:absoluteerror', eval_metric='mae',\n                learning_rate=best_params.get('learning_rate', 0.02),\n                max_depth=best_params.get('max_depth', 6),\n                min_child_weight=best_params.get('min_child_weight', 1),\n                subsample=best_params.get('subsample', 0.8),\n                colsample_bytree=best_params.get('colsample_bytree', 0.8),\n                reg_alpha=best_params.get('reg_alpha', 0.1),\n                reg_lambda=best_params.get('reg_lambda', 1.0),\n                gamma=best_params.get('gamma', 0.0),\n                tree_method='hist',\n                device='cuda' if CFG.USE_GPU else 'cpu',\n                random_state=seed, n_jobs=-1,\n                early_stopping_rounds=CFG.EARLY_STOPPING,\n            )\n            model.fit(Xf_tr, yf_tr, eval_set=[(Xf_val, yf_val)], verbose=False)\n            oof[val_idx] = model.predict(Xf_val)\n            train_pred = model.predict(Xf_tr)\n            test_preds += model.predict(X_te) / len(splits)\n            n_trees_used.append(model.best_iteration)\n            \n        elif model_type == 'CatBoost':\n            model = CatBoostRegressor(\n                iterations=5000, loss_function='MAE', eval_metric='MAE',\n                learning_rate=best_params.get('learning_rate', 0.02),\n                depth=best_params.get('depth', 6),\n                l2_leaf_reg=best_params.get('l2_leaf_reg', 3.0),\n                bagging_temperature=best_params.get('bagging_temperature', 1.0),\n                random_strength=best_params.get('random_strength', 1.0),\n                border_count=best_params.get('border_count', 128),\n                random_seed=seed,\n                task_type='GPU' if CFG.USE_GPU else 'CPU',\n                verbose=0, early_stopping_rounds=CFG.EARLY_STOPPING,\n            )\n            model.fit(Xf_tr, yf_tr, eval_set=(Xf_val, yf_val))\n            oof[val_idx] = model.predict(Xf_val)\n            train_pred = model.predict(Xf_tr)\n            test_preds += model.predict(X_te) / len(splits)\n            n_trees_used.append(model.best_iteration_)\n        \n        # Clip predictions (crowd count >= 0)\n        oof[val_idx] = np.clip(oof[val_idx], 0, None)\n        train_pred = np.clip(train_pred, 0, None)\n        \n        train_mae = mean_absolute_error(yf_tr, train_pred)\n        val_mae = mean_absolute_error(yf_val, oof[val_idx])\n        fold_train_scores.append(train_mae)\n        fold_val_scores.append(val_mae)\n        gap = val_mae - train_mae\n        \n        status = '✅' if gap < train_mae * 0.15 else ('⚠️' if gap < train_mae * 0.3 else '🔴')\n        print(f'  Fold {fold+1} | Train MAE: {train_mae:.4f} | Val MAE: {val_mae:.4f} | '\n              f'Gap: {gap:.4f} {status} | Trees: {n_trees_used[-1]}')\n    \n    # Clip final test predictions\n    test_preds = np.clip(test_preds, 0, None)\n    oof = np.clip(oof, 0, None)\n    \n    overall_mae = mean_absolute_error(y_tr, oof)\n    avg_gap = np.mean(fold_val_scores) - np.mean(fold_train_scores)\n    \n    print(f'\\n  📊 Overall OOF MAE: {overall_mae:.4f}')\n    print(f'  📊 Mean Train MAE:  {np.mean(fold_train_scores):.4f}')\n    print(f'  📊 Mean Val MAE:    {np.mean(fold_val_scores):.4f} (std: {np.std(fold_val_scores):.4f})')\n    print(f'  📊 Avg Gap: {avg_gap:.4f}')\n    \n    diagnostics = {\n        'train_scores': fold_train_scores,\n        'val_scores': fold_val_scores,\n        'avg_gap': avg_gap,\n        'std_val': np.std(fold_val_scores),\n        'n_trees': n_trees_used\n    }\n    \n    return oof, test_preds, overall_mae, diagnostics","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T22:27:21.036749Z","iopub.execute_input":"2026-11-24T22:27:21.037052Z","iopub.status.idle":"2026-11-24T22:27:21.054568Z","shell.execute_reply.started":"2026-11-24T22:27:21.037023Z","shell.execute_reply":"2026-11-24T22:27:21.053773Z"}},"outputs":[],"execution_count":22},{"cell_type":"code","source":"# ==============================================================================\n# TRAIN GLOBAL MODELS (all gap types combined)\n# ==============================================================================\ngroups_train = groups if use_group_kfold else None\n\nlgb_oof, lgb_test, lgb_mae, lgb_diag = trai