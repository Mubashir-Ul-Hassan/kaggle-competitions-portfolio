t, mae_gt, diag_gt = train_model_cv(\n            'LightGBM', X_gt, y_gt, X_test_gt, n_folds_gt, CFG.SEED, \n            best_lgb_params, groups_arr=groups_gt, label=f'Gap={gt}'\n        )\n        \n        per_gap_oof[gt] = (gt_mask_train, oof_gt)\n        per_gap_test[gt] = (gt_mask_test, test_gt)\n        \n        print(f'  {gt}: MAE={mae_gt:.4f}, samples={len(X_gt)}')\nelse:\n    print('No gap_type column found — using global models only')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T22:49:34.065564Z","iopub.execute_input":"2026-11-24T22:49:34.066092Z","iopub.status.idle":"2026-11-24T22:49:34.077078Z","shell.execute_reply.started":"2026-11-24T22:49:34.066061Z","shell.execute_reply":"2026-11-24T22:49:34.076399Z"}},"outputs":[{"name":"stdout","text":"No gap_type column found — using global models only\n","output_type":"stream"}],"execution_count":26},{"cell_type":"markdown","source":"<a id=\"ensemble\"></a>\n## 🔮 7. Ensemble & Post-Processing","metadata":{}},{"cell_type":"code","source":"# ==============================================================================\n# META-STACKING ENSEMBLE (Ridge on OOF predictions)\n# ==============================================================================\nprint('\\n' + '='*60)\nprint('Building Meta-Stacking Ensemble')\nprint('='*60)\n\n# Stack OOF predictions\nmeta_train = np.column_stack([lgb_oof, xgb_oof, cat_oof])\nmeta_test  = np.column_stack([lgb_test, xgb_test, cat_test])\n\n# Add interactions\nmeta_train_full = np.column_stack([\n    meta_train,\n    lgb_oof * xgb_oof,\n    lgb_oof * cat_oof,\n    xgb_oof * cat_oof,\n    np.mean(meta_train, axis=1),\n    np.std(meta_train, axis=1),\n])\nmeta_test_full = np.column_stack([\n    meta_test,\n    lgb_test * xgb_test,\n    lgb_test * cat_test,\n    xgb_test * cat_test,\n    np.mean(meta_test, axis=1),\n    np.std(meta_test, axis=1),\n])\n\n# Meta-learner: Ridge Regression (better than LR for regression tasks)\nmeta_oof = np.zeros(len(meta_train_full))\nmeta_test_preds = np.zeros(len(meta_test_full))\nmeta_scores = []\nmeta_train_scores_list = []\n\nsplits = get_cv_splits(CFG.N_FOLDS)\nfor fold, (tr_idx, val_idx) in enumerate(splits):\n    ridge = Ridge(alpha=1.0)\n    ridge.fit(meta_train_full[tr_idx], y[tr_idx])\n    \n    meta_oof[val_idx] = ridge.predict(meta_train_full[val_idx])\n    meta_test_preds += ridge.predict(meta_test_full) / len(splits)\n    \n    # Clip\n    meta_oof[val_idx] = np.clip(meta_oof[val_idx], 0, None)\n    \n    train_pred_meta = np.clip(ridge.predict(meta_train_full[tr_idx]), 0, None)\n    train_mae = mean_absolute_error(y[tr_idx], train_pred_meta)\n    fold_mae = mean_absolute_error(y[val_idx], np.clip(meta_oof[val_idx], 0, None))\n    meta_train_scores_list.append(train_mae)\n    meta_scores.append(fold_mae)\n    gap = fold_mae - train_mae\n    status = '✅' if gap < train_mae * 0.15 else ('⚠️' if gap < train_mae * 0.3 else '🔴')\n    print(f'  Meta Fold {fold+1} | Train MAE: {train_mae:.4f} | Val MAE: {fold_mae:.4f} | Gap: {gap:.4f} {status}')\n\nmeta_test_preds = np.clip(meta_test_preds, 0, None)\nmeta_oof = np.clip(meta_oof, 0, None)\nmeta_mae = mean_absolute_error(y, meta_oof)\nprint(f'\\n  📊 Meta-Stack OOF MAE: {meta_mae:.4f}')\n\n# Weighted average ensemble\ninv_lgb = 1.0 / (lgb_mae + 1e-8)\ninv_xgb = 1.0 / (xgb_mae + 1e-8)\ninv_cat = 1.0 / (cat_mae + 1e-8)\ntotal_inv = inv_lgb + inv_xgb + inv_cat\nw_lgb, w_xgb, w_cat = inv_lgb/total_inv, inv_xgb/total_inv, inv_cat/total_inv\n\navg_oof = np.clip(w_lgb * lgb_oof + w_xgb * xgb_oof + w_cat * cat_oof, 0, None)\navg_test = np.clip(w_lgb * lgb_test + w_xgb * xgb_test + w_cat * cat_test, 0, None)\navg_mae = mean_absolute_error(y, avg_oof)\n\nprint(f'  📊 Weighted Avg OOF MAE: {avg_mae:.4f} (w: lgb={w_lgb:.3f}, xgb={w_xgb:.3f}, cat={w_cat:.3f})')\n\n# Pick best global strategy\nif meta_mae <= avg_mae:\n    final_test_global = meta_test_preds\n    final_mae_global = meta_mae\n    final_oof_global = meta_oof\n    strategy = 'Me