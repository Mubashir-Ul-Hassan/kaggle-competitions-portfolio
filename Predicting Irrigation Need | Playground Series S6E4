ata":{}},{"cell_type":"code","source":"def feature_engineering(df):\n    \"\"\"Apply feature engineering to a DataFrame.\"\"\"\n    df = df.copy()\n    \n    # --- Interaction Features ---\n    # Temperature-Humidity interaction (evapotranspiration proxy)\n    if 'Temperature_C' in df.columns and 'Humidity' in df.columns:\n        df['Temp_x_Humidity'] = df['Temperature_C'] * df['Humidity']\n        df['Temp_Humidity_Ratio'] = df['Temperature_C'] / (df['Humidity'] + 1e-5)\n    \n    # Rainfall vs Soil Moisture\n    if 'Rainfall_mm' in df.columns and 'Soil_Moisture' in df.columns:\n        df['Rain_Moisture_Ratio'] = df['Rainfall_mm'] / (df['Soil_Moisture'] + 1e-5)\n        df['Rain_Moisture_Diff'] = df['Rainfall_mm'] - df['Soil_Moisture']\n    \n    # Weather stress index\n    if all(c in df.columns for c in ['Temperature_C', 'Sunlight_Hours', 'Wind_Speed_kmh']):\n        df['Weather_Stress'] = df['Temperature_C'] * df['Sunlight_Hours'] / (df['Wind_Speed_kmh'] + 1e-5)\n    \n    # Soil quality index\n    if all(c in df.columns for c in ['Soil_pH', 'Organic_Carbon', 'Electrical_Conductivity']):\n        df['Soil_Quality'] = df['Soil_pH'] * df['Organic_Carbon'] / (df['Electrical_Conductivity'] + 1e-5)\n    \n    # Evaporation proxy\n    if all(c in df.columns for c in ['Temperature_C', 'Wind_Speed_kmh', 'Humidity']):\n        df['Evaporation_Proxy'] = (df['Temperature_C'] * df['Wind_Speed_kmh']) / (df['Humidity'] + 1e-5)\n    \n    # Water balance\n    if 'Rainfall_mm' in df.columns and 'Previous_Irrigation_mm' in df.columns:\n        df['Total_Water_Input'] = df['Rainfall_mm'] + df['Previous_Irrigation_mm']\n    \n    if 'Previous_Irrigation_mm' in df.columns and 'Field_Area_hectare' in df.columns:\n        df['Irrigation_Per_Hectare'] = df['Previous_Irrigation_mm'] / (df['Field_Area_hectare'] + 1e-5)\n    \n    # Moisture deficit proxy\n    if 'Soil_Moisture' in df.columns and 'Temperature_C' in df.columns:\n        df['Moisture_Deficit'] = df['Soil_Moisture'] - (df['Temperature_C'] * 0.5)\n    \n    # Polynomial features for top predictors\n    if 'Soil_Moisture' in df.columns:\n        df['Soil_Moisture_sq'] = df['Soil_Moisture'] ** 2\n    if 'Temperature_C' in df.columns:\n        df['Temperature_sq'] = df['Temperature_C'] ** 2\n    if 'Rainfall_mm' in df.columns:\n        df['Rainfall_sq'] = df['Rainfall_mm'] ** 2\n    \n    return df\n\ntrain_fe = feature_engineering(train)\ntest_fe = feature_engineering(test)\n\nprint(f\"✅ Features after engineering: {train_fe.shape[1]} (was {train.shape[1]})\")\nprint(f\"   New features added: {train_fe.shape[1] - train.shape[1]}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T09:30:17.230355Z","iopub.execute_input":"2026-05-01T09:30:17.230708Z","iopub.status.idle":"2026-05-01T09:30:17.382497Z","shell.execute_reply.started":"2026-05-01T09:30:17.230682Z","shell.execute_reply":"2026-05-01T09:30:17.381864Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 4.1 Encoding Categorical Features","metadata":{}},{"cell_type":"code","source":"# Label encode target\nle_target = LabelEncoder()\ny = le_target.fit_transform(train_fe[TARGET])\ntarget_classes = le_target.classes_\nprint(f\"🎯 Target classes: {target_classes}\")\nprint(f\"🎯 Encoded as:     {list(range(len(target_classes)))}\")\n\n# Prepare feature matrices\ndrop_cols = [ID_COL, TARGET]\nfeature_cols = [c for c in train_fe.columns if c not in drop_cols]\n\nX = train_fe[feature_cols].copy()\nX_test = test_fe[feature_cols].copy()\n\n# Encode categoricals\nlabel_encoders = {}\nfor col in cat_cols:\n    if col in X.columns:\n        le = LabelEncoder()\n        combined = pd.concat([X[col], X_test[col]], axis=0).astype(str)\n        le.fit(combined)\n        X[col] = le.transform(X[col].astype(str))\n        X_test[col] = le.transform(X_test[col].astype(str))\n        label_encoders[col] = le\n\nprint(f\"\\n📐 Final X shape:      {X.shape}\")\nprint(f\"📐 Final X_test shape: {X_test.shape}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T09:30:17.383423Z","iopub.execute_input":"2026-05-01T09:30:17.383637Z","iopub.status.idle":"2026-05-01T09:30:19.306957Z","shell.execute_reply.started":"2026-05-01T09:30:17.383617Z","shell.execute_reply":"2026-05-01T09:30:19.306174Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"5\"></a>\n## 5. 🤖 Modeling\n\nWe use a robust **Stratified K-Fold Cross-Validation** strategy with multiple \ngradient boosting models, then blend their predictions for a strong final submission.\n\n> **Strategy**: Train LightGBM, XGBoost, and CatBoost separately with careful \n> hyperparameter tuning to avoid overfitting, then ensemble via soft voting.","metadata":{}},{"cell_type":"markdown","source":"### 5.1 🚀 LightGBM","metadata":{}},{"cell_type":"code","source":"lgb_params = {\n    'objective': 'multiclass',\n    'num_class': len(target_classes),\n    'metric': 'multi_logloss',\n    'boosting_type': 'gbdt',\n    'learning_rate': 0.05,\n    'num_leaves': 63,\n    'max_depth': 8,\n    'min_child_samples': 50,\n    'subsample': 0.8,\n    'colsample_bytree': 0.8,\n    'reg_alpha': 0.1,\n    'reg_lambda': 1.0,\n    'n_estimators': 2000,\n    'random_state': SEED,\n    'verbose': -1,\n    'is_unbalance': True,\n}\n\nskf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)\nlgb_oof_proba = np.zeros((len(X), len(target_classes)))\nlgb_test_proba = np.zeros((len(X_test), len(target_classes)))\nlgb_scores = []\n\nprint(f\"{'='*60}\")\nprint(f\"🚀 LightGBM Training — {N_FOLDS}-Fold Stratified CV\")\nprint(f\"{'='*60}\")\n\nfor fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):\n    X_tr, X_val = X.iloc[train_idx], X.iloc[val_idx]\n    y_tr, y_val = y[train_idx], y[val_idx]\n    \n    model = lgb.LGBMClassifier(**lgb_params)\n    model.fit(\n        X_tr, y_tr,\n        eval_set=[(X_val, y_val)],\n        callbacks=[\n            lgb.early_stopping(100, verbose=False),\n            lgb.log_evaluation(0),\n        ]\n    )\n    \n    val_proba = model.predict_proba(X_val)\n    lgb_oof_proba[val_idx] = val_proba\n    lgb_test_proba += model.predict_proba(X_test) / N_FOLDS\n    \n    val_pred = np.argmax(val_proba, axis=1)\n    score = balanced_accuracy_score(y_val, val_pred)\n    lgb_scores.append(score)\n    print(f\"  Fold {fold+1:2d} | Balanced Accuracy: {score:.5f} | Best Iter: {model.best_iteration_}\")\n\nlgb_oof_pred = np.argmax(lgb_oof_proba, axis=1)\nlgb_cv = balanced_accuracy_score(y, lgb_oof_pred)\nprint(f\"\\n{'='*60}\")\nprint(f\"📊 LightGBM CV Balanced Accuracy: {lgb_cv:.5f} (±{np.std(lgb_scores):.5f})\")\nprint(f\"{'='*60}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T09:30:19.308124Z","iopub.execute_input":"2026-05-01T09:30:19.308453Z","iopub.status.idle":"2026-05-01T09:52:13.864513Z","shell.execute_reply.started":"2026-05-01T09:30:19.308418Z","shell.execute_reply":"2026-05-01T09:52:13.863329Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Feature importance from LightGBM\nfeat_imp = pd.DataFrame({\n    'feature': X.columns,\n    'importance': model.feature_importances_\n}).sort_values('importance', ascending=True).tail(20)\n\nfig, ax = plt.subplots(figsize=(10, 8))\nbars = ax.barh(feat_imp['feature'], feat_imp['importance'], color='#2ecc71', edgecolor='white')\nax.set_title('🏆 Top 20 Feature Importances (LightGBM)', fontsize=16, fontweight='bold')\nax.set_xlabel('Importance')\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T09:52:13.865824Z","iopub.execute_input":"2026-05-01T09:52:13.86626Z","iopub.status.idle":"2026-05-01T09:52:14.170416Z","shell.execute_reply.started":"2026-05-01T09:52:13.866234Z","shell.execute_reply":"2026-05-01T09:52:14.169749Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 5.2 🔥 XGBoost","metadata":{}},{"cell_type":"code","source":"xgb_params = {\n    'objective': 'multi:softprob',\n    'num_class': len(target_classes),\n    'eval_metric': 'mlogloss',\n    'learning_rate': 0.05,\n    'max_depth': 8,\n    'min_child_weight': 50,\n    'subsample': 0.8,\n    'colsample_bytree': 0.8,\n    'reg_alpha': 0.1,\n    'reg_lambda': 1.0,\n    'n_estimators': 2000,\n    'early_stopping_rounds': 100,\n    'random_state': SEED,\n    'tree_method': 'hist',\n    'verbosity': 0,\n    'enable_categorical': False,\n}\n\nxgb_oof_proba = np.zeros((len(X), len(target_classes)))\nxgb_test_proba = np.zeros((len(X_test), len(target_classes)))\nxgb_scores = []\n\nprint(f\"\\n{'='*60}\")\nprint(f\"🔥 XGBoost Training — {N_FOLDS}-Fold Stratified CV\")\nprint(f\"{'='*60}\")\n\nfor fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):\n    X_tr, X_val = X.iloc[train_idx], X.iloc[val_idx]\n    y_tr, y_val = y[train_idx], y[val_idx]\n    \n    model_xgb = xgb.XGBClassifier(**xgb_params)\n    model_xgb.fit(\n        X_tr, y_tr,\n        eval_set=[(X_val, y_val)],\n        verbose=False,\n    )\n    \n    val_proba = model_xgb.predict_proba(X_val)\n    xgb_oof_proba[val_idx] = val_proba\n    xgb_test_proba += model_xgb.predict_proba(X_test) / N_FOLDS\n    \n    val_pred = np.argmax(val_proba, axis=1)\n    score = balanced_accuracy_score(y_val, val_pred)\n    xgb_scores.append(score)\n    print(f\"  Fold {fold+1:2d} | Balanced Accuracy: {score:.5f} | Best Iter: {model_xgb.best_iteration}\")\n\nxgb_oof_pred = np.argmax(xgb_oof_proba, axis=1)\nxgb_cv = balanced_accuracy_score(y, xgb_oof_pred)\nprint(f\"\\n{'='*60}\")\nprint(f\"📊 XGBoost CV Balanced Accuracy: {xgb_cv:.5f} (±{np.std(xgb_scores):.5f})\")\nprint(f\"{'='*60}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T09:52:14.171549Z","iopub.execute_input":"2026-05-01T09:52:14.171926Z","iopub.status.idle":"2026-05-01T10:15:41.542555Z","shell.execute_reply.started":"2026-05-01T09:52:14.1719Z","shell.execute_reply":"2026-05-01T10:15:41.541864Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 5.3 🐱 CatBoost","metadata":{}},{"cell_type":"code","source":"# Re-prepare data with original categoricals for CatBoost\nX_cat = train_fe[feature_cols].copy()\nX_test_cat = test_fe[feature_cols].copy()\ncat_features_idx = [X_cat.columns.get_loc(c) for c in cat_cols if c in X_cat.columns]\nfor col in cat_cols:\n    if col in X_cat.columns:\n        X_cat[col] = X_cat[col].astype(str)\n        X_test_cat[col] = X_test_cat[col].astype(str)\n\ncb_oof_proba = np.zeros((len(X_cat), len(target_classes)))\ncb_test_proba = np.zeros((len(X_test_cat), len(target_classes)))\ncb_scores = []\n\nprint(f\"\\n{'='*60}\")\nprint(f\"🐱 CatBoost Training — {N_FOLDS}-Fold Stratified CV\")\nprint(f\"{'='*60}\")\n\nfor fold, (train_idx, val_idx) in enumerate(skf.split(X_cat, y)):\n    X_tr = X_cat.iloc[train_idx]\n    X_val = X_cat.iloc[val_idx]\n    y_tr, y_val = y[train_idx], y[val_idx]\n    \n    model_cb = cb.CatBoostClassifier(\n        iterations=2000,\n        learning_rate=0.05,\n        depth=8,\n        l2_leaf_reg=3.0,\n        random_seed=SEED,\n        verbose=0,\n        auto_class_weights='Balanced',\n        cat_features=cat_features_idx,\n        early_stopping_rounds=100,\n        eval_metric='TotalF1',\n        task_type='CPU',\n    )\n    model_cb.fit(X_tr, y_tr, eval_set=(X_val, y_val), verbose=0)\n    \n    val_proba = model_cb.predict_proba(X_val)\n    cb_oof_proba[val_idx] = val_proba\n    cb_test_proba += model_cb.predict_proba(X_test_cat) / N_FOLDS\n    \n    val_pred = np.argmax(val_proba, axis=1)\n    score = balanced_accuracy_score(y_val, val_pred)\n    cb_scores.append(score)\n    print(f\"  Fold {fold+1:2d} | Balanced Accuracy: {score:.5f} | Best Iter: {model_cb.best_iteration_}\")\n\ncb_oof_pred = np.argmax(cb_oof_proba, axis=1)\ncb_cv = balanced_accuracy_score(y, cb_oof_pred)\nprint(f\"\\n{'='*60}\")\nprint(f\"📊 CatBoost CV Balanced Accuracy: {cb_cv:.5f} (±{np.std(cb_scores):.5f})\")\nprint(f\"{'='*60}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T10:15:41.543701Z","iopub.execute_input":"2026-05-01T10:15:41.544041Z","iopub.status.idle":"2026-05-01T14:25:53.522212Z","shell.execute_reply.started":"2026-05-01T10:15:41.544016Z","shell.execute_reply":"2026-05-01T14:25:53.521303Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 5.4 🏆 Ensemble — Weighted Probability Blending\n\n> We blend the predicted probabilities from all three models. The weight for each\n> model is proportional to its CV score, ensuring stronger models contribute more.","metadata":{}},{"cell_type":"code","source":"# Optimized weighted blending based on CV scores\nscores = np.array([lgb_cv, xgb_cv, cb_cv])\nweights = scores / scores.sum()\nprint(f\"📊 Model weights (proportional to CV):\")\nprint(f\"   LightGBM:  {weights[0]:.4f} (CV: {lgb_cv:.5f})\")\nprint(f\"   XGBoost:   {weights[1]:.4f} (CV: {xgb_cv:.5f})\")\nprint(f\"   CatBoost:  {weights[2]:.4f} (CV: {cb_cv:.5f})\")\n\n# Blend OOF\nens_oof_proba = (weights[0] * lgb_oof_proba + weights[1] * xgb_oof_proba + weights[2] * cb_oof_proba)\nens_oof_pred = np.argmax(ens_oof_proba, axis=1)\nens_cv = balanced_accuracy_score(y, ens_oof_pred)\n\n# Blend test\nens_test_proba = (weights[0] * lgb_test_proba + weights[1] * xgb_test_proba + weights[2] * cb_test_proba)\nens_test_pred = np.argmax(ens_test_proba, axis=1)\n\nprint(f\"\\n{'='*60}\")\nprint(f\"🏆 ENSEMBLE CV Balanced Accuracy: {ens_cv:.5f}\")\nprint(f\"{'='*60}\")\n\n# Compare all models\nprint(f\"\\n📊 Final Model Comparison:\")\nprint(f\"{'Model':<15} {'CV Score':<12} {'Std':<10}\")\nprint(f\"{'-'*37}\")\nfor name, cv, std in [('LightGBM', lgb_cv, np.std(lgb_scores)),\n                       ('XGBoost', xgb_cv, np.std(xgb_scores)),\n                       ('CatBoost', cb_cv, np.std(cb_scores)),\n                       ('Ensemble', ens_cv, 0.0)]:\n    marker = ' 🏆' if name == 'Ensemble' else ''\n    print(f\"{name:<15} {cv:.5f}      {std:.5f}{marker}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T14:25:53.52344Z","iopub.execute_input":"2026-05-01T14:25:53.523894Z","iopub.status.idle":"2026-05-01T14:25:53.579615Z","shell.execute_reply.started":"2026-05-01T14:25:53.523851Z","shell.execute_reply":"2026-05-01T14:25:53.578913Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<a id=\"6\"></a>\n## 6. 📊 Model Evaluation & Interpretation","metadata":{}},{"cell_type":"code","source":"# Confusion Matrix\nfig, axes = plt.subplots(1, 3, figsize=(20, 5))\n\nfor ax, (name, preds) in zip(axes, [('LightGBM', lgb_oof_pred),\n                                       ('XGBoost', xgb_oof_pred),\n                                       ('Ensemble', ens_oof_pred)]):\n    cm = confusion_matrix(y, preds)\n    disp = ConfusionMatrixDisplay(cm, display_labels=target_classes)\n    disp.plot(ax=ax, cmap='Greens', values_format='d')\n    ba = balanced_accuracy_score(y, preds)\n    ax.set_title(f'{name}\\nBalanced Acc: {ba:.5f}', fontweight='bold')\n\nplt.suptitle('📊 Confusion Matrices (OOF Predictions)', fontsize=18, fontweight='bold', y=1.05)\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T14:25:53.581259Z","iopub.execute_input":"2026-05-01T14:25:53.581873Z","iopub.status.idle":"2026-05-01T14:25:54.165865Z","shell.execute_reply.started":"2026-05-01T14:25:53.581839Z","shell.execute_reply":"2026-05-01T14:25:54.165101Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Classification report for ensemble\nprint(\"📋 Classification Report (Ensemble - OOF):\\n\")\nprint(classification_report(y, ens_oof_pred, target_names=[str(c) for c in target_classes]))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-01T14:25:54.167019Z","iopub.execute_input":"2026-05-01T14:25:54.167359Z","iopub.status.idle":"2026-05-01T14:25:54.269527Z","shell.execute_reply.started":"2026-05-01T14:25:54.167314Z","shell.execute_reply